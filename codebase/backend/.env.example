# Cấu hình LLM cho trợ lý soạn câu hỏi.
# Chép tệp này thành `backend/.env` rồi điền khoá thật (`.env` đã nằm trong .gitignore).
# Thiếu OPENAI_KEY hoặc MODEL thì các nút AI tự động bị tắt, phần còn lại vẫn chạy bình thường.

# Endpoint tương thích OpenAI. Ví dụ:
#   https://api.openai.com/v1
#   https://openrouter.ai/api/v1
#   http://localhost:11434/v1        (Ollama)
OPENAI_BASE_URL=https://api.openai.com/v1

OPENAI_KEY=
MODEL=gpt-4o-mini

# Thời gian chờ tối đa cho một lần gọi LLM (giây).
LLM_TIMEOUT_SEC=60
